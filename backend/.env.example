# Copy to .env and fill in. NEVER commit .env or real secrets.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3307/customer_onboarding"

# Razorpay (test mode during development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Form (public link; opened by the "Get Started" button)
NEXT_PUBLIC_GOOGLE_FORM_URL_PRODUCT_A="https://docs.google.com/forms/d/e/<FORM_ID>/viewform?usp=header"

# Admin (generate ADMIN_SESSION_SECRET with: openssl rand -base64 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-real-gmail@gmail.com
SMTP_PASS=your-real-google-app-password
MAIL_FROM=your-real-gmail@gmail.com
SUPPORT_EMAIL=your-real-gmail@gmail.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com
BRAND_NAME=Customer Onboarding

# Google Sheets (service account; share the sheet with its email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escapes inside the quotes
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_TAB=Customer_Payments


