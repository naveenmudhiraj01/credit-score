# ==============================================================================
# Unified Next.js Application Environment Configuration
# Copy this file to .env and configure for your environment.
# WARNING: NEVER commit .env or real credentials/secrets to version control.
# ==============================================================================

# Database Configuration (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3307/customer_onboarding"

# Razorpay Payment Gateway (Test or Live Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Admin Authentication & Session Management
# Generate a strong 32-byte secret: openssl rand -base64 32
ADMIN_PASSWORD="your_strong_admin_password"
ADMIN_SESSION_SECRET="your_32_byte_session_secret"

# Brand & Public UI Branding
NEXT_PUBLIC_BRAND_NAME="FFA FINSERV"
BRAND_NAME="FFA FINSERV"

# Support & Admin Notification Contacts
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
SUPPORT_EMAIL="support@example.com"

# Google Sheets Integration (for customer registration logging & sync)
NEXT_PUBLIC_GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/your_sheet_id/edit"
GOOGLE_SHEET_ID="your_google_sheet_id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# Keep the \n escapes inside the quotes for the private key
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_TAB="Customer_Payments"

# Email Notifications (SMTP configuration via Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
MAIL_FROM="FFA FINSERV <your-email@gmail.com>"
