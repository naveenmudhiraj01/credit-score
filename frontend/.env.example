# Brand shown in header / emails-facing UI
VITE_BRAND_NAME=YourBrand

# Optional: link used by the admin "Google Sheets" page
VITE_GOOGLE_SHEET_URL=
VITE_ADMIN_EMAIL=admin@yourdomain.com

# Dev proxy target (Next.js backend)
BACKEND_URL=http://localhost:3000

# Optional: support email shown on the customer dashboard (no default; when empty the support card shows a neutral "unavailable" message)
VITE_SUPPORT_EMAIL=
